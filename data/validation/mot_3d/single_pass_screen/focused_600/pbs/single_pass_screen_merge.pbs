#!/bin/bash
#PBS -q zeus_combined_q
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=00:15:00
#PBS -N mot3d_single_pass_merge

cd ~/ytterbium_lab_simulation_new
mkdir -p data/validation/mot_3d/logs
LOG_SUFFIX="${PBS_ARRAY_INDEX:-single}"
LOG_STEM="data/validation/mot_3d/logs/${PBS_JOBNAME}_${PBS_JOBID}_${LOG_SUFFIX}"
exec > "${LOG_STEM}.out" 2> "${LOG_STEM}.err"
source ~/venvs/atomsmltr/bin/activate

python -u -m studies.merge_3d_mot_single_pass_screen \
    --input-root data/validation/mot_3d/single_pass_screen/focused_600 --output-dir data/validation/mot_3d/single_pass_screen/focused_600/merged \
    --graph-dir graphs/mot_3d_single_pass_screen
