#!/bin/bash
#PBS -q zeus_combined_q
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l walltime=00:30:00
#PBS -N mot3d_donut_ablation_merge

cd ~/ytterbium_lab_simulation_new
mkdir -p data/validation/mot_3d/logs
LOG_SUFFIX="${PBS_ARRAY_INDEX:-single}"
LOG_STEM="data/validation/mot_3d/logs/${PBS_JOBNAME}_${PBS_JOBID}_${LOG_SUFFIX}"
exec > "${LOG_STEM}.out" 2> "${LOG_STEM}.err"
source ~/venvs/atomsmltr/bin/activate

python -u -m studies.merge_3d_mot_donut_ablation_shards \
    --input-root data/validation/mot_3d/donut_ablation/full_600_100ms --output-dir data/validation/mot_3d/donut_ablation/full_600_100ms/merged \
    --graph-dir graphs/mot_3d_donut_ablation
